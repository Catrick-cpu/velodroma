{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velodroma",
  "version": "1.0.0",
  "identifier": "app.velodroma.desktop",
  "build": {
    "frontendDist": "../../src/client/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Velodroma",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Sports",
    "shortDescription": "Virtual cycling + social fitness",
    "longDescription": "Velodroma — ride virtual worlds, chase segments and KOMs, and share activities with friends.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

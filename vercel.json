{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --workspace src/shared run build && npm --workspace src/server run build && npm --workspace src/client/web run build",
  "outputDirectory": "src/client/web/dist",
  "rewrites": [
    { "source": "/((?!models/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
